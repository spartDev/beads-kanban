{
  "name": "beads-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/server/cli.ts --dev\" \"vite\"",
    "build": "vite build && esbuild src/server/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@tailwindcss/vite": "4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "4",
    "concurrently": "9",
    "esbuild": "0.25",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "globals": "16",
    "jsdom": "^30.1.3",
    "tailwindcss": "4",
    "tsx": "4",
    "typescript": "5",
    "typescript-eslint": "8",
    "vite": "6",
    "vitest": "3"
  },
  "dependencies": {
    "@fastify/static": "8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "5",
    "@visx/axis": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "cmdk": "^1.1.1",
    "fastify": "5",
    "lucide-react": "^1.60.0",
    "open": "10",
    "react": "19",
    "react-dom": "19",
    "react-router": "7"
  },
  "bin": {
    "beads-desktop": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
