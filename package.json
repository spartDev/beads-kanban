{
  "name": "beads-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/server/cli.ts --dev\" \"vite\"",
    "build": "vite build && esbuild src/server/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@tailwindcss/vite": "4",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "4",
    "concurrently": "9",
    "esbuild": "0.25",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "globals": "16",
    "tailwindcss": "4",
    "tsx": "4",
    "typescript": "5",
    "typescript-eslint": "8",
    "vite": "6",
    "vitest": "3"
  },
  "dependencies": {
    "@fastify/static": "8",
    "@tanstack/react-query": "5",
    "fastify": "5",
    "open": "10",
    "react": "19",
    "react-dom": "19"
  },
  "bin": {
    "beads-desktop": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
